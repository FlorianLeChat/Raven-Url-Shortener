######################
# Symfony parameters #
######################

## List of supported timezones: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

## List of supported environments: dev, test, prod
ENV_NAME=dev

## Version displayed on the welcome page and in the OpenAPI documentation
# > Set by the CI/CD pipeline to the Git tag, or to the short commit hash outside a tag
VERSION=0.0.1

## API restrictions
# > A private API only answers the allowed origins sending PRIVATE_API_KEY in the X-Api-Key HTTP header
# > Leave PRIVATE_API_KEY empty to disable the key check, as the browser of the front-end cannot hold it
# > Allowed origins must be a comma-separated list of URLs, or '*' without quotes to allow all
# > CORS headers is automatically set for allowed origins
PRIVATE_API=false
PRIVATE_API_KEY=
PRIVATE_API_ALLOWED_ORIGINS=http://localhost:3000

## Administrator API key
# > Protects the administrator routes, such as the review of a report, whether the API is private or public
# > Sent in the Authorization HTTP header, it replaces PRIVATE_API_KEY, the password and the API key of any link,
#   skips the CAPTCHA and is not counted by the rate limiter
# > Leave it empty to disable the administrator routes
ADMIN_API_KEY=

## CAPTCHA parameters
# > A private API requires a solved ALTCHA challenge on the link creation and report requests: https://altcha.org/
# > CAPTCHA_HMAC signs the challenges: it must be a long random string, and is required when the API is private
CAPTCHA_HMAC=

## Trusted reverse proxies
# > This applies only in production environment
# > Comma-separated list of IP addresses or subnets allowed to set X-Forwarded-* headers
# > 'private_ranges' trusts every private address: restrict it to your reverse proxy
#   to prevent clients from spoofing their IP address and bypassing the rate limiter
TRUSTED_PROXIES=private_ranges

## Rate limiter parameters
# > This applies only in production environment
RATE_LIMIT_ENABLED=false
RATE_LIMIT_READ_API=60
RATE_LIMIT_WRITE_API=30

########################
# Database credentials #
########################

# > List of supported database types: https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/introduction.html#introduction
DATABASE_TYPE=postgresql
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=raven_url_shortener
DATABASE_VERSION=18
DATABASE_USERNAME=username
DATABASE_PASSWORD=password

#####################
# Cache credentials #
#####################

CACHE_HOST=valkey
CACHE_USERNAME=default
CACHE_PASSWORD=password

####################
# SMTP credentials #
####################

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=username
SMTP_PASSWORD=password
