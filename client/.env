######################
# Next.js parameters #
######################

## List of supported timezones: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

## List of supported environments: development, production
NEXT_PUBLIC_ENV=development

## Version displayed in the footer
# > Set by the CI/CD pipeline to the Git tag, or to the short commit hash outside a tag
NEXT_PUBLIC_VERSION=0.0.1

## URL to the backend API server
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

## Base path when the application is served from a sub-path (e.g. /url)
# > Leave empty to serve the application from the domain root
NEXT_PUBLIC_BASE_PATH=

## CAPTCHA parameters
# > The browser solves ALTCHA challenges, an open-source, privacy-friendly CAPTCHA solution: https://altcha.org/
# > The API creates and checks them only when it is private: enable it together with PRIVATE_API on the server
NEXT_PUBLIC_CAPTCHA_ENABLED=false

## Analytics parameters
# > Data collection is made through umami, an open-source analytics solution: https://umami.is/
# > Enabling DNT (Do Not Track) user preference is recommended to respect user privacy: https://en.wikipedia.org/wiki/Do_Not_Track
# > It also covers GPC (Global Privacy Control), the signal most browsers now send instead: https://globalprivacycontrol.org/
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENDPOINT=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_PROJECT_ID=
NEXT_PUBLIC_ANALYTICS_RESPECT_DNT=true
